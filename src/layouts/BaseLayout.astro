---
import '@/styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import DeCAResources from '@components/DeCAResources.astro';
import ProductEvaluation from '@components/ProductEvaluation.astro';
import { RESOURCE_HUB_PATHS, PRODUCT_EVALUATION_PATHS, normalizePath } from '../config/public-site.mjs';
import { SOCIAL_CARDS, socialCardKey, socialImage } from '../config/social-cards.mjs';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  canonical,
  noindex = false,
  ogType = 'website',
  schema,
} = Astro.props;

const site = Astro.site ?? new URL('https://gauna.es');
const siteOrigin = site.origin;

const canonicalURL = canonical
  ? new URL(canonical, site).toString()
  : new URL(Astro.url.pathname, site).toString();

const pagePath = normalizePath(new URL(canonicalURL).pathname);
const generatedSocialImage = !ogImage;
const ogImageURL = new URL(ogImage ?? socialImage(pagePath), site).toString();
const imageAlt = ogImageAlt ?? SOCIAL_CARDS[socialCardKey(pagePath)].alt;

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteOrigin}/#organization`,
    name: 'Gauna Software',
    alternateName: 'Gauna',
    url: siteOrigin,
    logo: `${siteOrigin}/logo.svg`,
    description:
      'Estudio de software especializado en herramientas digitales para empresas de transporte.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Elche',
      addressRegion: 'Alicante',
      addressCountry: 'ES',
    },
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+34624067213',
        email: 'hola@gauna.es',
        contactType: 'customer support',
        availableLanguage: ['es'],
      },
    ],
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    name: 'Gauna Software',
    alternateName: 'Gauna',
    url: siteOrigin,
    inLanguage: 'es-ES',
    publisher: {
      '@id': `${siteOrigin}/#organization`,
    },
  },
];

const customSchema = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const enrichedCustomSchema = customSchema.map((entry) => {
  if (entry['@type'] !== 'Article') return entry;

  return {
    ...entry,
    url: entry.url ?? canonicalURL,
    // Replace only the old generic article logo; preserve explicit editorial images.
    image: entry.image === `${siteOrigin}/logo.svg` ? ogImageURL : entry.image ?? ogImageURL,
    datePublished: entry.datePublished ?? entry.dateModified,
  };
});

const structuredData = [...baseSchema, ...enrichedCustomSchema];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Identidad -->
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Gauna Software" />
    <meta name="application-name" content="Gauna Software" />
    <meta name="theme-color" content="#0D9488" />
    <meta name="color-scheme" content="light" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {generatedSocialImage && <>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>}
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Gauna Software" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="gauna.es" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Preconnect para performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </head>

  <body class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <slot />
      {PRODUCT_EVALUATION_PATHS.includes(pagePath) && <ProductEvaluation />}
      {RESOURCE_HUB_PATHS.includes(pagePath) && <DeCAResources />}
    </main>

    <a
      href="https://wa.me/34624067213?text=Hola%20Gauna%2C%20me%20gustar%C3%ADa%20recibir%20informaci%C3%B3n."
      target="_blank"
      rel="noopener noreferrer"
      data-placement="floating"
      aria-label="Contactar con Gauna Software por WhatsApp"
      title="Contactar por WhatsApp"
      class="fixed right-5 bottom-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105 focus:outline-none focus:ring-4 focus:ring-emerald-200"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.208-.242-.579-.487-.5-.669-.51-.173-.009-.371-.011-.57-.011-.198 0-.52.074-.792.371-.272.298-1.04 1.017-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.625.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 017.021 2.91 9.825 9.825 0 012.9 7.025c-.003 5.45-4.437 9.884-9.925 9.884m8.413-18.297A11.815 11.815 0 0012.055 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.689 1.448h.005c6.558 0 11.893-5.335 11.896-11.893a11.821 11.821 0 00-3.488-8.413z" />
      </svg>
    </a>

    <Footer />
  </body>
</html>

<script>
  import { installIntentTracking } from '../lib/navigation-intent.mjs';
  installIntentTracking(window, document);
</script>
