---
import { DECA_GUIDE } from '../config/deca-guide.mjs';
// Compatibility wrapper for existing placements. No simulated forms or subscriptions.
export interface Props { variant?: 'inline' | 'card' | 'hero'; headline?: string; subheadline?: string; id?: string; }
const { variant = 'card', id = 'guide-resource' } = Astro.props;
---
<aside id={id} class:list={['rounded-xl border border-slate-200 bg-white text-slate-900', variant === 'inline' ? 'p-5' : 'p-6 md:p-8']} aria-labelledby={`${id}-title`}>
  <span class="eyebrow">Guía gratuita</span>
  <h3 id={`${id}-title`} class="mt-2 text-2xl font-medium leading-tight">Llévate la Guía DeCA 2026 en PDF.</h3>
  <p class="mt-3 leading-relaxed text-slate-600">{DECA_GUIDE.pages} páginas con requisitos, responsabilidades y herramientas prácticas. Edición {DECA_GUIDE.version}; revisión {DECA_GUIDE.reviewed}.</p>
  <a href="/deca-2026/#formulario-deca" class="btn-primary mt-5 text-center">Recibir o descargar la guía</a>
  <p class="mt-3 text-xs leading-relaxed text-slate-500">La solicitud de la guía no te suscribe a una newsletter.</p>
</aside>
