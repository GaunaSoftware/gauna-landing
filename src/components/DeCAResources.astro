---
import { DECA_RESOURCES } from '../config/public-site.mjs';
---

<section id="recursos-deca" aria-labelledby="recursos-deca-title" class="scroll-mt-24 border-t border-slate-200 bg-slate-50 py-16 md:py-20">
  <div class="container-g">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-3xl">
        <span class="eyebrow">Recursos relacionados</span>
        <h2 id="recursos-deca-title" class="mt-3 text-display-sm font-medium leading-tight text-slate-900">Profundiza en lo que necesita tu empresa.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Pasa del resumen general a la duda concreta: requisitos técnicos, trabajo en carretera, diferencias entre documentos o conexión con tu software de gestión.</p>
      </div>
      <nav aria-label="Artículos para preparar la operativa DeCA" class="mt-9 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {DECA_RESOURCES.map((resource) => (
          <a href={resource.href} class="group block rounded-2xl border border-slate-200 bg-white p-6 transition-colors hover:border-teal-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700">
            <h3 class="text-lg font-semibold leading-snug text-slate-900 group-hover:text-teal-800">{resource.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{resource.description}</p>
            <span aria-hidden="true" class="mt-5 inline-block text-sm font-medium text-teal-700">Leer el artículo →</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>
