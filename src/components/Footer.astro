---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const footerCols = [
  {
    title: 'Producto',
    links: [
      { href: '/transgest/', label: 'TransGest' },
      { href: '/transgest/precios/', label: 'Planes y precios' },
      { href: '/software-deca/', label: 'Software DeCA' },
      { href: '/solicitar-demo/', label: 'Solicitar demo' },
      { href: 'https://app.gauna.es', label: 'Acceso clientes', external: true },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { href: '/deca-2026/', label: 'Guía DeCA' },
      { href: '/blog/', label: 'Blog' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { href: '/sobre-nosotros/', label: 'Sobre nosotros' },
      { href: '/contacto/', label: 'Contacto' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/politica-privacidad/', label: 'Política de privacidad' },
      { href: '/aviso-legal/', label: 'Aviso legal' },
      { href: '/politica-cookies/', label: 'Política de cookies' },
    ],
  },
];
---

<footer class="bg-slate-900 text-slate-300 mt-24">
  <div class="container-g py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <Logo variant="compact" theme="dark" class="h-9 w-auto mb-4" />
        <p class="text-sm text-slate-400 leading-relaxed max-w-xs">Gauna Software desarrolla tecnología especializada para empresas de transporte.</p>

        <div class="mt-6 space-y-2 text-sm">
          <a href="tel:+34624067213" class="flex items-center gap-2 text-slate-400 hover:text-teal-400 transition-colors">
            <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.684l1.5 4.5a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.5 1.5a1 1 0 01.684.95V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            624 067 213
          </a>

          <a href="mailto:hola@gauna.es" class="flex items-center gap-2 text-slate-400 hover:text-teal-400 transition-colors">
            <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-18 8h18a2 2 0 002-2V6a2 2 0 00-2-2H3a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            hola@gauna.es
          </a>

          <a
            href="https://wa.me/34624067213?text=Hola%20Gauna%2C%20me%20gustar%C3%ADa%20recibir%20informaci%C3%B3n."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-slate-400 hover:text-[#25D366] transition-colors"
          >
            <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.208-.242-.579-.487-.5-.669-.51-.173-.009-.371-.011-.57-.011-.198 0-.52.074-.792.371-.272.298-1.04 1.017-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.625.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 017.021 2.91 9.825 9.825 0 012.9 7.025c-.003 5.45-4.437 9.884-9.925 9.884m8.413-18.297A11.815 11.815 0 0012.055 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.689 1.448h.005c6.558 0 11.893-5.335 11.896-11.893a11.821 11.821 0 00-3.488-8.413z" />
            </svg>
            WhatsApp
          </a>
        </div>

        <p class="text-sm text-slate-500 mt-6">Elche, Alicante · España</p>
      </div>

      <div class="md:col-span-8 grid grid-cols-2 sm:grid-cols-4 gap-8">
        {footerCols.map((col) => (
          <div>
            <h3 class="text-sm font-medium text-white mb-4">{col.title}</h3>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined} class="text-sm text-slate-400 hover:text-teal-400 transition-colors">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-slate-500">© {year} Gauna Software. Todos los derechos reservados.</p>
      <p class="text-xs text-slate-500">Software creado desde la realidad del transporte.</p>
    </div>
  </div>
</footer>
