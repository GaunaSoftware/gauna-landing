---
import Honeypot from './Honeypot.astro';
import Turnstile from './Turnstile.astro';

export interface Props {
  id?: string;
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  buttonLabel?: string;
  source?: string;
}

const {
  id = 'deca-lead-form',
  eyebrow = '¿Quieres prepararlo con tiempo?',
  headline = 'Te ayudamos a revisar cómo encaja el DeCA en tu operativa.',
  subheadline = 'Déjanos tus datos y te contactaremos para explicarte qué necesitas preparar y cómo puede integrarse en TransGest.',
  buttonLabel = 'Quiero preparar el DeCA',
  source = 'LEAD DECA 2026',
} = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm" data-deca-wrapper>
  <div class="mb-6">
    <span class="eyebrow">{eyebrow}</span>
    <h3 class="text-2xl md:text-3xl font-medium text-slate-900 mt-2 leading-tight">{headline}</h3>
    <p class="text-slate-600 mt-3 leading-relaxed">{subheadline}</p>
  </div>

  <form id={id} class="space-y-4" data-deca-lead-form data-source={source}>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for={`${id}-name`} class="block text-sm font-medium text-slate-700 mb-1.5">Nombre *</label>
        <input id={`${id}-name`} name="name" type="text" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
      <div>
        <label for={`${id}-company`} class="block text-sm font-medium text-slate-700 mb-1.5">Empresa *</label>
        <input id={`${id}-company`} name="company" type="text" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for={`${id}-email`} class="block text-sm font-medium text-slate-700 mb-1.5">Email *</label>
        <input id={`${id}-email`} name="email" type="email" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
      <div>
        <label for={`${id}-phone`} class="block text-sm font-medium text-slate-700 mb-1.5">Teléfono *</label>
        <input id={`${id}-phone`} name="phone" type="tel" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
    </div>

    <div>
      <label for={`${id}-profile`} class="block text-sm font-medium text-slate-700 mb-1.5">Tipo de empresa *</label>
      <select id={`${id}-profile`} name="profile" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 text-slate-700">
        <option value="">Selecciona...</option>
        <option value="Autónomo">Autónomo del transporte</option>
        <option value="Pyme pequeña">Pyme con 2-5 vehículos</option>
        <option value="Pyme mediana">Pyme con 6-30 vehículos</option>
        <option value="Empresa grande">Empresa con 30+ vehículos</option>
        <option value="Operador logístico">Operador logístico</option>
        <option value="Gestoría">Gestoría / asesoría</option>
      </select>
    </div>

    <Honeypot />
    <Turnstile formId={id} />

    <div class="flex items-start gap-2 pt-1">
      <input id={`${id}-consent`} name="consent" type="checkbox" required class="mt-1 rounded text-teal-600" />
      <label for={`${id}-consent`} class="text-xs text-slate-500 leading-relaxed">
        Acepto que Gauna trate mis datos para responder a mi solicitud y contactarme sobre DeCA y TransGest.
        <a href="/politica-privacidad/" class="underline hover:text-teal-600">Política de privacidad</a>.
      </label>
    </div>

    <div class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-900" data-deca-error></div>

    <button type="submit" class="btn-primary w-full text-base py-4" data-deca-submit>
      <span data-deca-text>{buttonLabel}</span>
      <span data-deca-loading class="hidden">Enviando...</span>
    </button>
  </form>

  <div class="hidden p-5 bg-teal-50 border border-teal-200 rounded-xl" data-deca-success>
    <p class="font-medium text-teal-900">Solicitud recibida.</p>
    <p class="text-sm text-teal-800 mt-1">Revisaremos tu caso y contactaremos contigo.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-deca-lead-form]').forEach((form) => {
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const wrapper = form.closest('[data-deca-wrapper]');
      const success = wrapper?.querySelector('[data-deca-success]');
      const errorBox = wrapper?.querySelector('[data-deca-error]');
      const button = form.querySelector<HTMLButtonElement>('[data-deca-submit]');
      const text = form.querySelector('[data-deca-text]');
      const loading = form.querySelector('[data-deca-loading]');
      if (!button) return;

      button.disabled = true;
      text?.classList.add('hidden');
      loading?.classList.remove('hidden');
      errorBox?.classList.add('hidden');

      const data = new FormData(form);
      const source = form.dataset.source || 'LEAD DECA 2026';
      const payload = {
        name: data.get('name'),
        company: data.get('company'),
        email: data.get('email'),
        phone: data.get('phone'),
        profile: data.get('profile'),
        why: `[${source}] Solicita información sobre DeCA y cómo puede integrarse en la operativa con TransGest.`,
        website: data.get('website'),
        turnstileToken: data.get('turnstileToken'),
        startedAt: data.get('startedAt'),
      };

      try {
        const response = await fetch('/api/beta-signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'No se ha podido enviar el formulario');

        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Error desconocido';
        if (errorBox) {
          errorBox.textContent = `No hemos podido enviar la solicitud: ${message}. También puedes escribirnos a hola@gauna.es.`;
          errorBox.classList.remove('hidden');
        }
        button.disabled = false;
        text?.classList.remove('hidden');
        loading?.classList.add('hidden');
      }
    });
  });
</script>
