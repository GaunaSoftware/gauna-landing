---
import Honeypot from './Honeypot.astro';
import Turnstile from './Turnstile.astro';
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
  <div class="mb-6">
    <span class="eyebrow">¿Quieres prepararlo con tiempo?</span>
    <h3 class="text-2xl md:text-3xl font-medium text-slate-900 mt-2 leading-tight">
      Te ayudamos a revisar cómo encaja el DeCA en tu operativa.
    </h3>
    <p class="text-slate-600 mt-3 leading-relaxed">
      Déjanos tus datos y te contactaremos para explicarte qué necesitas preparar y cómo puede integrarse en TransGest.
    </p>
  </div>

  <form id="deca-lead-form" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="deca-name" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre *</label>
        <input id="deca-name" name="name" type="text" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
      <div>
        <label for="deca-company" class="block text-sm font-medium text-slate-700 mb-1.5">Empresa *</label>
        <input id="deca-company" name="company" type="text" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="deca-email" class="block text-sm font-medium text-slate-700 mb-1.5">Email *</label>
        <input id="deca-email" name="email" type="email" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
      <div>
        <label for="deca-phone" class="block text-sm font-medium text-slate-700 mb-1.5">Teléfono *</label>
        <input id="deca-phone" name="phone" type="tel" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
      </div>
    </div>

    <div>
      <label for="deca-profile" class="block text-sm font-medium text-slate-700 mb-1.5">Tipo de empresa *</label>
      <select id="deca-profile" name="profile" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 text-slate-700">
        <option value="">Selecciona...</option>
        <option value="Autónomo">Autónomo del transporte</option>
        <option value="Pyme pequeña">Pyme con 2-5 vehículos</option>
        <option value="Pyme mediana">Pyme con 6-30 vehículos</option>
        <option value="Empresa grande">Empresa con 30+ vehículos</option>
        <option value="Operador logístico">Operador logístico</option>
        <option value="Gestoría">Gestoría / asesoría</option>
      </select>
    </div>

    <Honeypot />
    <Turnstile formId="deca-lead-form" />

    <div class="flex items-start gap-2 pt-1">
      <input id="deca-consent" name="consent" type="checkbox" required class="mt-1 rounded text-teal-600" />
      <label for="deca-consent" class="text-xs text-slate-500 leading-relaxed">
        Acepto que Gauna trate mis datos para responder a mi solicitud y contactarme sobre DeCA y TransGest.
        <a href="/politica-privacidad/" class="underline hover:text-teal-600">Política de privacidad</a>.
      </label>
    </div>

    <div id="deca-form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-900"></div>

    <button id="deca-submit" type="submit" class="btn-primary w-full text-base py-4">
      <span data-deca-text>Quiero preparar el DeCA</span>
      <span data-deca-loading class="hidden">Enviando...</span>
    </button>
  </form>

  <div id="deca-form-success" class="hidden p-5 bg-teal-50 border border-teal-200 rounded-xl">
    <p class="font-medium text-teal-900">Solicitud recibida.</p>
    <p class="text-sm text-teal-800 mt-1">Revisaremos tu caso y contactaremos contigo.</p>
  </div>
</div>

<script>
  const decaForm = document.getElementById('deca-lead-form') as HTMLFormElement | null;
  const decaSuccess = document.getElementById('deca-form-success');
  const decaError = document.getElementById('deca-form-error');
  const decaButton = document.getElementById('deca-submit') as HTMLButtonElement | null;
  const decaText = document.querySelector('[data-deca-text]');
  const decaLoading = document.querySelector('[data-deca-loading]');

  decaForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!decaForm || !decaButton) return;

    decaButton.disabled = true;
    decaText?.classList.add('hidden');
    decaLoading?.classList.remove('hidden');
    decaError?.classList.add('hidden');

    const data = new FormData(decaForm);
    const payload = {
      name: data.get('name'),
      company: data.get('company'),
      email: data.get('email'),
      phone: data.get('phone'),
      profile: data.get('profile'),
      why: '[LEAD DECA 2026] Solicita información para preparar la empresa para el DeCA y conocer cómo puede integrarse con TransGest.',
      website: data.get('website'),
      turnstileToken: data.get('turnstileToken'),
      startedAt: data.get('startedAt'),
    };

    try {
      const response = await fetch('/api/beta-signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'No se ha podido enviar el formulario');

      decaForm.classList.add('hidden');
      decaSuccess?.classList.remove('hidden');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Error desconocido';
      if (decaError) {
        decaError.textContent = `No hemos podido enviar la solicitud: ${message}. También puedes escribirnos a hola@gauna.es.`;
        decaError.classList.remove('hidden');
      }
      decaButton.disabled = false;
      decaText?.classList.remove('hidden');
      decaLoading?.classList.add('hidden');
    }
  });
</script>
