---
import DeCARequestForm from './DeCARequestForm.astro';
export interface Props {
  id?: string;
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  buttonLabel?: string;
  source?: string;
}
const { id = 'deca-lead-form', source = 'LEAD DECA 2026', headline, subheadline } = Astro.props;
// Keep the published guide section anchor, but do not turn an information request into a subscription.
const kind = source === 'LEAD GUIA DECA 2026' ? 'guide' : 'information';
---
<DeCARequestForm id={id} kind={kind} headline={headline} subheadline={subheadline} />
