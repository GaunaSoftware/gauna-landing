---
import { DECA_GUIDE, DECA_PROFILES } from '../config/deca-guide.mjs';
interface Props { id: string; kind: 'guide' | 'information'; headline?: string; subheadline?: string; }
const { id, kind, headline, subheadline } = Astro.props;
const guide = kind === 'guide';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const fieldClass = 'w-full min-w-0 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-teal-600';
---

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8" data-deca-request-wrapper>
  <span class="eyebrow">{guide ? 'Recurso gratuito' : 'DeCA y TransGest'}</span>
  <h3 class="mt-2 text-2xl font-medium leading-tight text-slate-900 md:text-3xl">{guide ? 'Recibe la Guía DeCA 2026 en PDF.' : headline || 'Revisamos el DeCA en tu operativa.'}</h3>
  <p class="mt-3 leading-relaxed text-slate-600">{guide ? `Edición ${DECA_GUIDE.version} · ${DECA_GUIDE.pages} páginas · Revisión ${DECA_GUIDE.reviewed}. Requisitos, responsabilidades y herramientas prácticas. Te enviaremos un enlace al PDF y también podrás descargarlo aquí.` : subheadline || 'Cuéntanos qué necesitas y te contactaremos sobre DeCA y TransGest.'}</p>
  <form id={id} class="mt-6 space-y-4" method="post" action={guide ? '/api/guia-deca' : '/api/informacion-deca'} data-deca-request-form data-kind={kind}>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div><label for={`${id}-name`} class="mb-1.5 block text-sm font-medium text-slate-700">Nombre *</label><input id={`${id}-name`} name="name" autocomplete="given-name" maxlength="150" required class={fieldClass} /></div>
      <div><label for={`${id}-email`} class="mb-1.5 block text-sm font-medium text-slate-700">Email *</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="254" required class={fieldClass} /></div>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div><label for={`${id}-company`} class="mb-1.5 block text-sm font-medium text-slate-700">Empresa {guide ? '(opcional)' : '*'}</label><input id={`${id}-company`} name="company" autocomplete="organization" maxlength="200" required={!guide} class={fieldClass} /></div>
      <div><label for={`${id}-profile`} class="mb-1.5 block text-sm font-medium text-slate-700">Perfil (opcional)</label><select id={`${id}-profile`} name="profile" class={fieldClass}><option value="">Selecciona...</option>{DECA_PROFILES.map(profile => <option value={profile}>{profile}</option>)}</select></div>
    </div>
    {!guide && <>
      <div><label for={`${id}-phone`} class="mb-1.5 block text-sm font-medium text-slate-700">Teléfono *</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="60" required class={fieldClass} /></div>
      <div><label for={`${id}-message`} class="mb-1.5 block text-sm font-medium text-slate-700">¿Qué necesitas resolver? (opcional)</label><textarea id={`${id}-message`} name="message" maxlength="3000" rows="3" class={fieldClass}></textarea></div>
    </>}
    <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true"><label for={`${id}-website`}>Deja este campo vacío</label><input id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" /></div>
    {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible" data-action={`deca_${kind}`} data-response-field-name="turnstileToken" data-deca-captcha></div> : <p class="text-sm text-amber-900">El envío por correo no está disponible en este entorno. Puedes usar el contacto directo.</p>}
    <div class="flex items-start gap-2"><input id={`${id}-consent`} name="consent" type="checkbox" required class="mt-1 rounded text-teal-700" /><label for={`${id}-consent`} class="text-sm leading-relaxed text-slate-600">{guide ? 'Solicito recibir la guía y acepto el tratamiento de estos datos para gestionar su entrega.' : 'Solicito información y acepto el tratamiento de estos datos para responder y contactar conmigo sobre DeCA y TransGest.'} <a href="/politica-privacidad/" class="underline">Política de privacidad</a>.</label></div>
    {guide && <div class="flex items-start gap-2"><input id={`${id}-contact`} name="contactRequested" type="checkbox" class="mt-1 rounded text-teal-700" /><label for={`${id}-contact`} class="text-sm leading-relaxed text-slate-600">También quiero que contactéis conmigo para valorar TransGest en mi empresa (opcional).</label></div>}
    <p class="text-xs leading-relaxed text-slate-500">Responsable: Gauna Software. {guide ? 'La solicitud de la guía no te suscribe a publicidad ni a una newsletter.' : 'No se crea una suscripción a una newsletter.'} Consulta tus derechos e información adicional en la política de privacidad.</p>
    <button type="submit" disabled={!siteKey} class="btn-primary w-full py-4 text-center disabled:opacity-50" data-deca-request-submit>{guide ? 'Recibir la guía gratuita en PDF' : 'Solicitar información'}</button>
  </form>
  <div class="mt-5 hidden rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm leading-relaxed text-slate-800" role="status" aria-live="polite" tabindex="-1" data-deca-request-status></div>
  {guide && <p class="mt-5 text-sm text-slate-600">También está disponible la <a href={DECA_GUIDE.path} download={DECA_GUIDE.filename} class="font-medium text-teal-800 underline">descarga directa del PDF</a>.</p>}
  <p class="mt-4 text-sm text-slate-600">Contacto directo: <a href="mailto:hola@gauna.es" class="underline">hola@gauna.es</a>.</p>
  <noscript><p class="mt-3 text-sm">El envío por correo requiere JavaScript. Utiliza la descarga directa o escríbenos.</p></noscript>
</div>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import { bindDeCAForms } from '../lib/deca-form-client.mjs';
  bindDeCAForms(window, document);
</script>
