---
// Approved wordmark: clean vector paths, with a separate T icon for favicons.

export interface Props {
  variant?: 'full' | 'compact' | 'hero';
  class?: string;
  alt?: string;
  theme?: 'light' | 'dark';
}

const {
  variant = 'full',
  class: className = '',
  alt = 'TransGest',
  theme = 'light',
} = Astro.props;

const sizes = {
  full: 'h-9 md:h-10',      // Para usos normales
  compact: 'h-7 md:h-8',     // Para header/menús
  hero: 'h-12 md:h-16',      // Para hero principal de página
};
---

<img
  src={`/media/transgest/transgest-wordmark-v3${theme === 'dark' ? '-white' : ''}.svg`}
  alt={alt}
  class:list={[sizes[variant], 'w-auto', className]}
  loading="eager"
  decoding="async"
/>
