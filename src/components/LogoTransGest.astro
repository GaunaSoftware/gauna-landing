---
// Owner-supplied transparent PNG. CSS frames its transparent margins without changing the artwork.

export interface Props {
  variant?: 'full' | 'compact' | 'hero';
  class?: string;
  alt?: string;
  theme?: 'light' | 'dark';
}

const {
  variant = 'full',
  class: className = '',
  alt = 'TransGest',
  theme = 'light',
} = Astro.props;

const sizes = {
  full: 'h-9 md:h-10',      // Para usos normales
  compact: 'h-7 md:h-8',     // Para header/menús
  hero: 'h-12 md:h-16',      // Para hero principal de página
};
---

<img
  src="/media/transgest/transgest-logo-v4.png"
  width="2172"
  height="300"
  alt={alt}
  class:list={[sizes[variant], 'w-auto', 'transgest-logo', theme === 'dark' && 'transgest-logo--on-dark', className]}
  style="aspect-ratio: 2172 / 300; object-fit: cover; object-position: center 48.8%;"
  loading="eager"
  decoding="async"
/>
<style is:global>
  .transgest-logo {max-width:100%;display:block;}
  .transgest-logo--on-dark {filter:brightness(0) invert(1);}
</style>
