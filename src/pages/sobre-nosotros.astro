---
import BaseLayout from '@layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = 'Sobre Gauna Software | Tecnología creada desde el transporte';
const pageDescription =
  'Gauna Software desarrolla tecnología para empresas de transporte desde el conocimiento real del sector. Conoce nuestra visión, forma de trabajar y el origen de TransGest.';

const principles = [
  {
    title: 'Conocer antes de construir',
    text: 'Partimos de cómo trabajan de verdad tráfico, administración, conductores y gerencia antes de decidir qué debe hacer el software.',
  },
  {
    title: 'Menos trabajo repetitivo',
    text: 'Buscamos reducir pasos manuales, información duplicada, documentos dispersos y tareas que consumen tiempo sin aportar valor.',
  },
  {
    title: 'Producto que evoluciona',
    text: 'El transporte cambia rápido. Diseñamos una base capaz de incorporar nuevas necesidades, integraciones, automatización y normativa sin obligar a empezar de cero.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': 'https://gauna.es/sobre-nosotros/#webpage',
    url: 'https://gauna.es/sobre-nosotros/',
    name: pageTitle,
    description: pageDescription,
    inLanguage: 'es-ES',
    isPartOf: { '@id': 'https://gauna.es/#website' },
    about: { '@id': 'https://gauna.es/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://gauna.es/sobre-nosotros/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gauna.es/' },
      { '@type': 'ListItem', position: 2, name: 'Sobre nosotros', item: 'https://gauna.es/sobre-nosotros/' },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/sobre-nosotros/"
  ogImageAlt="Gauna Software, tecnología para empresas de transporte"
  schema={schema}
>
  <section class="relative overflow-hidden pt-16 md:pt-24 pb-16 md:pb-20 border-b border-slate-100">
    <div class="absolute inset-0 bg-gradient-to-br from-teal-50/60 via-white to-white pointer-events-none"></div>
    <div class="container-g relative">
      <div class="max-w-4xl mx-auto text-center">
        <span class="eyebrow">Sobre Gauna</span>
        <h1 class="text-display-sm md:text-display-md lg:text-display-lg font-medium text-slate-900 mt-5 leading-[1.05]">
          Tecnología para transporte creada
          <span class="text-teal-700">desde dentro del sector.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 mt-6 max-w-3xl mx-auto leading-relaxed">
          Gauna Software nace de conocer de cerca la operativa del transporte y de una idea sencilla:
          el software debería quitar trabajo, dar control y adaptarse a la empresa, no al revés.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container-g">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[.85fr_1.15fr] gap-10 lg:gap-16 items-start">
        <div>
          <span class="eyebrow">Por qué nace Gauna</span>
          <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">El problema no era la falta de software. Era cómo estaba pensado.</h2>
        </div>

        <div class="space-y-5 text-lg text-slate-700 leading-relaxed">
          <p>
            En muchas empresas de transporte, una misma operación acaba repartida entre el TMS, Excel, WhatsApp,
            correo, carpetas, llamadas y documentos independientes. El resultado es más trabajo administrativo y menos visibilidad.
          </p>
          <p>
            Gauna nace desde la experiencia real en tráfico y logística para replantear esa forma de trabajar.
            Queremos que la información del servicio fluya entre tráfico, administración, conductor, cliente y gerencia sin volver a introducirla una y otra vez.
          </p>
          <p>
            De esa visión nace <strong>TransGest</strong>: nuestro TMS para centralizar la operativa y construir sobre una base más conectada, trazable y preparada para seguir evolucionando.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-slate-50 border-y border-slate-100">
    <div class="container-g">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow">Cómo pensamos el producto</span>
        <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">Tres principios, sin complicarlo más.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-6xl mx-auto mt-10">
        {principles.map((item) => (
          <article class="bg-white border border-slate-200 rounded-2xl p-6 md:p-7">
            <h3 class="text-lg font-medium text-slate-900">{item.title}</h3>
            <p class="text-slate-600 mt-3 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container-g">
      <div class="max-w-5xl mx-auto rounded-3xl border border-slate-200 p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_.9fr] gap-10 items-center">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-medium tracking-widest uppercase text-teal-800 bg-teal-50 px-3 py-1.5 rounded-full">
              <span class="w-2 h-2 rounded-full bg-teal-600"></span>
              Disponible
            </div>
            <h2 class="text-3xl md:text-4xl font-medium text-slate-900 mt-5 leading-tight">TransGest es el primer gran producto de Gauna.</h2>
            <p class="text-slate-600 mt-5 leading-relaxed">
              Un TMS para conectar tráfico, servicios, clientes, vehículos, conductores, documentación, facturación y análisis en un mismo entorno.
              Lo desarrollamos con una visión de largo plazo: que pueda crecer con la empresa y con la evolución del transporte.
            </p>
            <div class="mt-7 flex flex-col sm:flex-row gap-3">
              <a href="/transgest/" class="btn-primary">Conocer TransGest</a>
              <a href="/solicitar-demo/" class="btn-secondary">Solicitar demo</a>
            </div>
          </div>

          <div class="rounded-2xl bg-slate-950 text-white p-7">
            <div class="text-xs uppercase tracking-widest text-teal-300 font-medium">Nuestra dirección</div>
            <p class="text-2xl font-medium mt-4 leading-snug">Construir software que devuelva tiempo a las empresas de transporte.</p>
            <p class="text-slate-400 mt-4 leading-relaxed">
              Menos tareas repetitivas. Más información conectada. Más capacidad para controlar la operativa y tomar decisiones.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-slate-950 text-white">
    <div class="container-g">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-xs font-medium tracking-widest uppercase text-teal-300">Hablemos</span>
        <h2 class="text-display-sm font-medium mt-4 leading-tight">Si trabajas en transporte, queremos entender cómo trabajas.</h2>
        <p class="text-lg text-slate-300 mt-5 leading-relaxed">
          Puedes solicitar una demo de TransGest o contarnos directamente qué problema operativo estás intentando resolver.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/solicitar-demo/" class="btn-accent">Solicitar demo</a>
          <a href="/contacto/" class="btn-secondary bg-slate-900 text-white border-slate-700 hover:bg-slate-800">Contactar</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
