---
import BaseLayout from '@layouts/BaseLayout.astro';
import Turnstile from '@components/Turnstile.astro';
import Honeypot from '@components/Honeypot.astro';

export const prerender = false;

const pageTitle = 'Solicitar demo de TransGest | TMS para empresas de transporte';
const pageDescription =
  'Solicita una demo personalizada de TransGest y descubre cómo centralizar tráfico, documentación, vehículos, conductores, clientes y facturación en un solo TMS.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://gauna.es/solicitar-demo/#webpage',
    url: 'https://gauna.es/solicitar-demo/',
    name: pageTitle,
    description: pageDescription,
    inLanguage: 'es-ES',
    isPartOf: { '@id': 'https://gauna.es/#website' },
    about: { '@id': 'https://gauna.es/transgest/#software' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://gauna.es/solicitar-demo/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gauna.es/' },
      { '@type': 'ListItem', position: 2, name: 'TransGest', item: 'https://gauna.es/transgest/' },
      { '@type': 'ListItem', position: 3, name: 'Solicitar demo', item: 'https://gauna.es/solicitar-demo/' },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/solicitar-demo/"
  ogImageAlt="Solicitar una demo de TransGest"
  schema={schema}
>
  <section class="relative overflow-hidden bg-slate-950 text-white pt-16 md:pt-24 pb-16 md:pb-20">
    <div class="absolute inset-0 bg-gradient-to-br from-teal-900/45 via-slate-950 to-slate-950 pointer-events-none"></div>
    <div class="container-g relative">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block text-xs font-medium tracking-widest uppercase text-teal-300">Demo personalizada</span>
        <h1 class="text-display-sm md:text-display-md lg:text-display-lg font-medium mt-5 leading-[1.05]">
          Mira TransGest aplicado a<br class="hidden md:block" />
          <span class="text-amber-400">la operativa de tu empresa.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 mt-6 max-w-3xl mx-auto leading-relaxed">
          Cuéntanos qué tipo de empresa tienes y te enseñamos cómo centralizar tráfico, documentación,
          vehículos, conductores, clientes y facturación en una sola plataforma.
        </p>
        <a href="#formulario" class="btn-accent inline-flex mt-9">Solicitar demo</a>
      </div>
    </div>
  </section>

  <section id="formulario" class="scroll-mt-24 py-16 md:py-24 bg-slate-50">
    <div class="container-g">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[.8fr_1.2fr] gap-10 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28">
          <span class="eyebrow">Sin presentación genérica</span>
          <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">Una demo centrada en cómo trabajas de verdad.</h2>
          <p class="text-slate-600 mt-5 leading-relaxed">
            Queremos entender tu operativa antes de enseñarte funciones. Así podemos centrarnos en los puntos donde TransGest puede aportar más valor.
          </p>

          <div class="mt-8 space-y-5">
            <div class="flex gap-3">
              <span class="text-teal-700 mt-0.5">✓</span>
              <div>
                <div class="font-medium text-slate-900">Tráfico y servicios</div>
                <p class="text-sm text-slate-600 mt-1">Pedidos, planificación, vehículos, conductores, estados y seguimiento.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <span class="text-teal-700 mt-0.5">✓</span>
              <div>
                <div class="font-medium text-slate-900">Documentación y administración</div>
                <p class="text-sm text-slate-600 mt-1">Documentos, trazabilidad, facturación, cobros y procesos administrativos conectados.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <span class="text-teal-700 mt-0.5">✓</span>
              <div>
                <div class="font-medium text-slate-900">Tu caso concreto</div>
                <p class="text-sm text-slate-600 mt-1">Nos centramos en las áreas que hoy más tiempo o control te están costando.</p>
              </div>
            </div>
          </div>

          <p class="text-xs text-slate-500 mt-8">Sin compromiso. Tus datos se utilizan únicamente para gestionar la solicitud y contactarte sobre TransGest.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
          <div class="mb-7">
            <h2 class="text-2xl md:text-3xl font-medium text-slate-900">Solicita tu demo</h2>
            <p class="text-slate-600 mt-2">Solo necesitamos unos datos para preparar la conversación.</p>
          </div>

          <form id="demo-form" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="demo-name" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre y apellidos *</label>
                <input type="text" id="demo-name" name="name" autocomplete="name" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
              </div>
              <div>
                <label for="demo-company" class="block text-sm font-medium text-slate-700 mb-1.5">Empresa *</label>
                <input type="text" id="demo-company" name="company" autocomplete="organization" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="demo-email" class="block text-sm font-medium text-slate-700 mb-1.5">Email *</label>
                <input type="email" id="demo-email" name="email" autocomplete="email" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
              </div>
              <div>
                <label for="demo-phone" class="block text-sm font-medium text-slate-700 mb-1.5">Teléfono *</label>
                <input type="tel" id="demo-phone" name="phone" autocomplete="tel" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" />
              </div>
            </div>

            <div>
              <label for="demo-profile" class="block text-sm font-medium text-slate-700 mb-1.5">Tipo de empresa *</label>
              <select id="demo-profile" name="profile" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500">
                <option value="">Selecciona...</option>
                <option value="Autónomo">Autónomo del transporte</option>
                <option value="Empresa de transporte">Empresa de transporte</option>
                <option value="Operador logístico">Operador logístico</option>
                <option value="Almacén / logística">Almacén / logística</option>
                <option value="Gestoría">Gestoría / asesoría</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="demo-why" class="block text-sm font-medium text-slate-700 mb-1.5">¿Qué te gustaría mejorar? <span class="font-normal text-slate-400">(opcional)</span></label>
              <textarea id="demo-why" name="why" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" placeholder="Ej: planificación de tráfico, documentación, facturación, control de flota..."></textarea>
            </div>

            <Honeypot />
            <Turnstile formId="demo-form" />

            <div class="flex items-start gap-2">
              <input type="checkbox" id="demo-consent" name="consent" required class="mt-1 rounded text-teal-600" />
              <label for="demo-consent" class="text-xs text-slate-500 leading-relaxed">
                Acepto que Gauna trate mis datos para gestionar mi solicitud y contactarme sobre TransGest.
                <a href="/politica-privacidad/" class="underline hover:text-teal-600">Política de privacidad</a>.
              </label>
            </div>

            <div id="demo-form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg">
              <p class="text-sm text-red-900" data-error-message>Ha ocurrido un error. Intenta de nuevo o escríbenos a hola@gauna.es.</p>
            </div>

            <button type="submit" class="btn-primary w-full text-base py-4" id="demo-submit-btn">
              <span data-btn-text>Solicitar demo</span>
              <span data-btn-loading class="hidden">Enviando...</span>
            </button>
          </form>

          <div id="demo-form-success" class="hidden p-6 bg-teal-50 border border-teal-200 rounded-xl">
            <p class="font-medium text-teal-900">Solicitud recibida</p>
            <p class="text-sm text-teal-800 mt-1">Gracias. Revisaremos tu solicitud y contactaremos contigo por email o teléfono.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white border-t border-slate-100">
    <div class="container-g">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow">Antes de la demo</span>
        <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">¿Quieres conocer primero qué incluye TransGest?</h2>
        <p class="text-lg text-slate-600 mt-5">Consulta el producto, sus módulos y el enfoque con el que estamos construyendo la gestión del transporte.</p>
        <a href="/transgest/" class="btn-secondary inline-flex mt-8">Ver TransGest</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('demo-form');
  const successBox = document.getElementById('demo-form-success');
  const errorBox = document.getElementById('demo-form-error');
  const errorMsg = document.querySelector('[data-error-message]');
  const btn = document.getElementById('demo-submit-btn');
  const btnText = document.querySelector('[data-btn-text]');
  const btnLoading = document.querySelector('[data-btn-loading]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btn) return;

    btn.disabled = true;
    btnText?.classList.add('hidden');
    btnLoading?.classList.remove('hidden');
    errorBox?.classList.add('hidden');

    const formData = new FormData(form);
    const userMessage = String(formData.get('why') || '').trim();

    const payload = {
      type: 'demo',
      name: formData.get('name'),
      company: formData.get('company'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      profile: formData.get('profile'),
      why: `[SOLICITUD DEMO TRANSGEST]\n\n${userMessage || 'Solicitud enviada desde la página de demo.'}`,
      website: formData.get('website'),
      turnstileToken: formData.get('turnstileToken'),
      startedAt: formData.get('startedAt'),
    };

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Error del servidor');

      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
      successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Error desconocido';
      if (errorMsg) errorMsg.textContent = `No hemos podido enviar tu solicitud: ${message}. Puedes escribirnos directamente a hola@gauna.es.`;
      errorBox?.classList.remove('hidden');
      btn.disabled = false;
      btnText?.classList.remove('hidden');
      btnLoading?.classList.add('hidden');
    }
  });
</script>
