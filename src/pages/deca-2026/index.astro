---
import BaseLayout from '@layouts/BaseLayout.astro';
import DeCALeadForm from '@components/DeCALeadForm.astro';

export const prerender = false;

const pageTitle = 'DeCA 2026: guía actualizada para empresas de transporte | Gauna';
const pageDescription =
  'Guía clara y actualizada del DeCA 2026: fecha obligatoria, PDF nativo, QR, URL HTTPS, datos exigidos, inspección y cómo preparar tu empresa.';

const faqs = [
  {
    q: '¿Cuándo será obligatorio el DeCA digital?',
    a: 'Desde el 5 de octubre de 2026, el documento de control administrativo exigible en el transporte público de mercancías por carretera deberá ser necesariamente digital.',
  },
  {
    q: '¿Vale escanear un documento en papel y guardarlo como PDF?',
    a: 'No. La Resolución de 5 de junio de 2026 exige generación nativa digital a partir de datos estructurados. No son válidos los PDF obtenidos escaneando papel o imágenes.',
  },
  {
    q: '¿El DeCA tiene que llevar QR?',
    a: 'Sí. El PDF debe incluir un código QR con una URL única y específica del documento. Esa URL debe permitir la descarga directa del PDF durante el servicio.',
  },
  {
    q: '¿Puede el conductor llevarlo en el móvil?',
    a: 'Sí. El conductor puede disponer del DeCA electrónicamente en un dispositivo móvil o llevar una copia impresa con el QR.',
  },
  {
    q: '¿Cuánto tiempo debe conservarse?',
    a: 'Los ficheros electrónicos deben conservarse durante al menos un año. La URL utilizada durante el servicio puede desactivarse siete días naturales después de finalizarlo.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': 'https://gauna.es/deca-2026/#article',
    headline: 'DeCA 2026: guía actualizada para empresas de transporte',
    description: pageDescription,
    dateModified: '2026-09-13',
    inLanguage: 'es-ES',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://gauna.es/deca-2026/',
    },
    author: { '@id': 'https://gauna.es/#organization' },
    publisher: { '@id': 'https://gauna.es/#organization' },
    about: [
      'DeCA',
      'Documento electrónico de control administrativo',
      'Documento de control digital',
      'Transporte público de mercancías por carretera',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://gauna.es/deca-2026/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gauna.es/' },
      { '@type': 'ListItem', position: 2, name: 'Guía DeCA 2026', item: 'https://gauna.es/deca-2026/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://gauna.es/deca-2026/#faq',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/deca-2026/"
  ogType="article"
  ogImageAlt="Guía DeCA 2026 para empresas de transporte"
  schema={schema}
>
  <!-- HERO -->
  <section class="relative overflow-hidden pt-16 md:pt-24 pb-16 md:pb-20 border-b border-slate-100">
    <div class="absolute inset-0 bg-gradient-to-br from-teal-50/50 via-white to-amber-50/40 pointer-events-none"></div>
    <div class="container-g relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white border border-amber-200 rounded-full shadow-sm text-sm font-medium text-amber-900">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Obligatorio en formato digital desde el 5 de octubre de 2026
        </div>

        <h1 class="text-display-sm md:text-display-md lg:text-display-lg font-medium text-slate-900 leading-[1.05] mt-7">
          DeCA 2026, explicado
          <span class="text-teal-700">sin complicaciones.</span>
        </h1>

        <p class="text-lg md:text-xl text-slate-600 mt-6 max-w-3xl mx-auto leading-relaxed">
          Qué cambia, qué debe contener el documento electrónico de control administrativo y qué tiene que preparar una empresa de transporte para cumplirlo.
        </p>

        <div class="mt-7 text-sm text-slate-500">
          Actualizado el 13 de septiembre de 2026 · Basado en normativa oficial del BOE
        </div>

        <div class="mt-9 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="#que-cambia" class="btn-primary">Ver qué cambia</a>
          <a href="#formulario-deca" class="btn-secondary">Quiero preparar mi empresa</a>
        </div>
      </div>
    </div>
  </section>

  <!-- RESUMEN -->
  <section id="que-cambia" class="scroll-mt-24 py-14 md:py-18 bg-slate-50">
    <div class="container-g">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-[.75fr_1.25fr] gap-6 items-stretch">
          <div class="rounded-2xl bg-slate-950 text-white p-7 md:p-9 flex flex-col justify-between">
            <div>
              <span class="text-xs uppercase tracking-widest text-teal-300 font-medium">Fecha clave</span>
              <div class="text-4xl md:text-5xl font-medium mt-4">05.10.2026</div>
              <p class="text-slate-300 mt-5 leading-relaxed">
                Desde esa fecha, el documento de control administrativo deberá ser necesariamente digital cuando resulte exigible.
              </p>
            </div>
            <p class="text-xs text-slate-500 mt-8">Ley 9/2025, de Movilidad Sostenible</p>
          </div>

          <div class="rounded-2xl bg-white border border-slate-200 p-7 md:p-9">
            <span class="eyebrow">Lo esencial</span>
            <h2 class="text-2xl md:text-3xl font-medium text-slate-900 mt-3">El DeCA no es simplemente un PDF.</h2>
            <p class="text-slate-600 mt-4 leading-relaxed">
              La Resolución de 5 de junio de 2026 exige que el documento se genere digitalmente desde datos estructurados y pueda verificarse fácilmente durante una inspección.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-7">
              <div class="border-t border-slate-200 pt-4">
                <div class="font-medium text-slate-900">PDF nativo · máximo 5 MB</div>
                <p class="text-sm text-slate-600 mt-1">No vale escanear un documento en papel.</p>
              </div>
              <div class="border-t border-slate-200 pt-4">
                <div class="font-medium text-slate-900">QR + URL única</div>
                <p class="text-sm text-slate-600 mt-1">El QR identifica y da acceso al documento concreto.</p>
              </div>
              <div class="border-t border-slate-200 pt-4">
                <div class="font-medium text-slate-900">Descarga directa</div>
                <p class="text-sm text-slate-600 mt-1">Sin login, autenticación ni botones intermedios.</p>
              </div>
              <div class="border-t border-slate-200 pt-4">
                <div class="font-medium text-slate-900">Conservación mínima: 1 año</div>
                <p class="text-sm text-slate-600 mt-1">Con trazabilidad cuando se modifica el documento.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-g">
      <div class="max-w-4xl mx-auto">
        <div class="max-w-2xl">
          <span class="eyebrow">En la práctica</span>
          <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">Cómo debe funcionar el DeCA durante un servicio.</h2>
          <p class="text-lg text-slate-600 mt-5 leading-relaxed">
            El objetivo de la nueva regulación es que la información sea digital, trazable y accesible en carretera sin depender de papeles ni de accesos internos de la empresa.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-10">
          {[
            ['01', 'Se genera', 'El sistema crea el DeCA desde los datos del servicio antes de iniciar el transporte.'],
            ['02', 'Se almacena', 'El PDF queda en un repositorio con una URL única y específica.'],
            ['03', 'Se entrega', 'El conductor recibe el documento o su QR, en formato digital o impreso.'],
            ['04', 'Se inspecciona', 'El agente escanea el QR y descarga directamente el PDF mediante HTTPS.'],
          ].map(([n, title, text]) => (
            <article class="rounded-2xl bg-slate-50 border border-slate-200 p-5">
              <div class="text-xs font-mono text-teal-700">{n}</div>
              <h3 class="text-lg font-medium text-slate-900 mt-3">{title}</h3>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">{text}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 rounded-2xl border border-teal-100 bg-teal-50 p-6 md:p-7">
          <p class="text-teal-950 font-medium">Inspección, resumida en una línea:</p>
          <p class="text-teal-900 mt-2 text-lg">QR → URL HTTPS → descarga directa del PDF.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DATOS OBLIGATORIOS -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="container-g">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
        <div>
          <span class="eyebrow">Contenido</span>
          <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">Qué información debe contener.</h2>
          <p class="text-lg text-slate-600 mt-5 leading-relaxed">
            El documento de control debe identificar con claridad la operación, las partes, el vehículo y la mercancía. No hace falta convertir la página en un formulario jurídico: lo importante es que el software pueda generar estos datos correctamente.
          </p>

          <div class="mt-7 text-sm text-slate-500 leading-relaxed">
            La Orden FOM/2861/2012 regula el contenido esencial. La Resolución de 2026 añade las condiciones técnicas para gestionarlo electrónicamente.
          </div>
        </div>

        <div class="rounded-2xl bg-white border border-slate-200 p-6 md:p-8">
          <ul class="space-y-4">
            {[
              'Cargador contractual y transportista efectivo.',
              'Origen y destino del envío.',
              'Naturaleza y peso de la mercancía.',
              'Fecha de realización del transporte.',
              'Matrícula del vehículo y del remolque o semirremolque cuando corresponda.',
              'Autorización especial de circulación, cuando sea exigible.',
              'Observaciones o reservas cuando las soliciten los intervinientes.',
            ].map((item) => (
              <li class="flex gap-3 text-slate-700">
                <span class="mt-1 w-5 h-5 flex-shrink-0 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center text-xs">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TRANSGEST -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-g">
      <div class="max-w-5xl mx-auto rounded-3xl bg-slate-950 text-white p-8 md:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_.85fr] gap-10 items-center">
          <div>
            <span class="text-xs uppercase tracking-widest text-teal-300 font-medium">TransGest + DeCA</span>
            <h2 class="text-3xl md:text-4xl font-medium mt-4 leading-tight">La idea no es crear otro PDF a mano.</h2>
            <p class="text-slate-300 mt-5 leading-relaxed">
              Si el TMS ya conoce el cliente, el servicio, el origen, el destino, la mercancía, el vehículo y el conductor, el DeCA debería salir de ese mismo flujo de trabajo. Ese es el enfoque que estamos aplicando en TransGest.
            </p>
            <div class="mt-7 flex flex-col sm:flex-row gap-3">
              <a href="/transgest/" class="btn-accent">Conocer TransGest</a>
              <a href="/solicitar-demo/" class="btn-secondary bg-slate-900 text-white border-slate-700 hover:bg-slate-800">Solicitar demo</a>
            </div>
          </div>

          <div class="space-y-3">
            {[
              'Datos del transporte ya estructurados',
              'Documento vinculado al servicio',
              'Acceso para oficina y conductor',
              'Trazabilidad documental',
              'Arquitectura preparada para seguir evolucionando hacia eFTI',
            ].map((item) => (
              <div class="flex items-center gap-3 py-3 border-b border-slate-800 last:border-0 text-slate-200">
                <span class="text-teal-300">✓</span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section id="formulario-deca" class="scroll-mt-24 py-16 md:py-24 bg-slate-50">
    <div class="container-g">
      <div class="max-w-3xl mx-auto">
        <DeCALeadForm />
      </div>
    </div>
  </section>

  <!-- FAQ + FUENTES -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-g">
      <div class="max-w-3xl mx-auto">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 class="text-display-sm font-medium text-slate-900 mt-3 leading-tight">Las dudas que más se repiten.</h2>

        <div id="faq" class="mt-8 space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-slate-200 bg-white">
              <summary class="cursor-pointer p-5 md:p-6 font-medium text-slate-900 flex items-start justify-between gap-4">
                <span>{faq.q}</span>
                <span class="text-slate-400 group-open:rotate-45 transition-transform">+</span>
              </summary>
              <div class="px-5 md:px-6 pb-5 md:pb-6 text-slate-600 leading-relaxed">{faq.a}</div>
            </details>
          ))}
        </div>

        <div class="mt-12 pt-8 border-t border-slate-200">
          <div class="text-sm font-medium text-slate-900">Fuentes oficiales</div>
          <p class="text-sm text-slate-500 mt-2 leading-relaxed">
            Esta guía se ha preparado a partir de la Resolución de 5 de junio de 2026 (BOE-A-2026-12784), la Ley 9/2025 de Movilidad Sostenible y la Orden FOM/2861/2012.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2026-12784" target="_blank" rel="noopener noreferrer" class="text-teal-700 hover:underline">Resolución 05/06/2026</a>
            <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2025-24545" target="_blank" rel="noopener noreferrer" class="text-teal-700 hover:underline">Ley 9/2025</a>
            <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2013-154" target="_blank" rel="noopener noreferrer" class="text-teal-700 hover:underline">Orden FOM/2861/2012</a>
          </div>
          <p class="text-xs text-slate-400 mt-5 leading-relaxed">
            Contenido informativo. Para casos particulares debe consultarse el texto oficial vigente y, cuando corresponda, asesoramiento especializado.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
