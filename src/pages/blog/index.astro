---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export const prerender = true;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = {
  normativa: { label: 'Normativa', color: 'bg-amber-100 text-amber-800' },
  gestion: { label: 'Gestión', color: 'bg-teal-100 text-teal-800' },
  nominas: { label: 'Nóminas', color: 'bg-slate-100 text-slate-800' },
  tecnologia: { label: 'Tecnología', color: 'bg-blue-100 text-blue-800' },
};
---

<BaseLayout
  title="Blog de transporte: DeCA 2026, normativa y gestión | Gauna"
  description="Guías sobre DeCA 2026, documento de control, normativa de transporte, digitalización, TMS y gestión de empresas de transporte por carretera."
  canonical="/blog/"
>
  <section class="py-16 md:py-20 border-b border-slate-100">
    <div class="container-g">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow">Blog de transporte</span>
        <h1 class="text-display-sm md:text-display-md font-medium text-slate-900 mt-4 leading-tight">
          DeCA 2026, normativa y gestión del transporte por carretera.
        </h1>
        <p class="text-lg text-slate-600 mt-6 leading-relaxed">
          Guías prácticas sobre el Documento electrónico de Control Administrativo, digitalización, TMS y gestión diaria de empresas de transporte.
        </p>
      </div>
    </div>
  </section>

  <section class="pt-12 md:pt-14">
    <div class="container-g">
      <div class="max-w-6xl mx-auto rounded-2xl border border-teal-100 bg-teal-50 p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-3xl">
          <span class="text-xs font-medium uppercase tracking-widest text-teal-700">Guía principal</span>
          <h2 class="text-2xl font-medium text-slate-900 mt-2">Todo lo que necesitas saber sobre el DeCA 2026.</h2>
          <p class="text-slate-600 mt-3 leading-relaxed">Fecha obligatoria, datos, PDF nativo, QR, URL HTTPS, conservación, cambios durante el viaje y relación con eFTI.</p>
        </div>
        <a href="/deca-2026/" class="btn-primary flex-shrink-0">Ver guía DeCA 2026</a>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-g">
      {posts.length === 0 ? (
        <div class="max-w-2xl mx-auto text-center py-20">
          <h2 class="text-2xl font-medium text-slate-900 mb-4">Estamos preparando nuevas guías</h2>
          <p class="text-slate-600 mb-8">Consulta mientras tanto nuestra guía actualizada del DeCA 2026.</p>
          <a href="/deca-2026/" class="btn-primary">Ver guía DeCA 2026</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {posts.map((post) => {
            const cat = categories[post.data.category];
            return (
              <a href={`/blog/${post.slug}/`} class="group">
                <article class="h-full flex flex-col bg-white rounded-xl border border-slate-200 overflow-hidden hover:border-teal-300 hover:shadow-md transition-all">
                  <div class="p-6 flex-1 flex flex-col">
                    <div class="flex items-center gap-2 mb-4">
                      <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-medium ${cat.color}`}>
                        {cat.label}
                      </span>
                      <time class="text-xs text-slate-500" datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </time>
                    </div>
                    <h2 class="text-xl font-medium text-slate-900 group-hover:text-teal-600 transition-colors leading-tight mb-3">
                      {post.data.title}
                    </h2>
                    <p class="text-slate-600 leading-relaxed flex-1">
                      {post.data.description}
                    </p>
                    <div class="mt-4 text-sm text-slate-500">
                      {post.data.author}
                    </div>
                  </div>
                </article>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
