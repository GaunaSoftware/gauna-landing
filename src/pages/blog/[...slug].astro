---
import BaseLayout from '@layouts/BaseLayout.astro';
import LeadMagnetForm from '@components/LeadMagnetForm.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const canonical = `/blog/${post.slug}/`;
const canonicalUrl = `https://gauna.es${canonical}`;
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();

// These two articles use real navigation CTAs while the guide delivery is pending.
// Keep all other blog pages unchanged by this focused SEO update.
const nextStep = post.slug === 'que-es-deca-transporte'
  ? {
      title: 'Del DeCA a tu operativa diaria',
      description: 'Descubre el enfoque de TransGest para conectar los datos del servicio con su documentación. En una demo podemos revisar tu caso y el alcance que necesitas.',
      productHref: '/software-deca/',
      productLabel: 'Ver software DeCA',
      resourceHref: '/deca-2026/',
      resourceLabel: 'Seguir leyendo la guía DeCA 2026',
    }
  : post.slug === 'que-es-un-tms-transporte'
    ? {
        title: 'Comprueba cómo encaja TransGest en tu empresa',
        description: 'Lleva a la demo un ejemplo de tu operativa y revisamos el recorrido entre tráfico, documentación y administración. Sin quedarnos en una lista de funciones.',
        productHref: '/transgest/',
        productLabel: 'Conocer el TMS TransGest',
        resourceHref: '/transgest/precios/',
        resourceLabel: 'Comparar las versiones de TransGest',
      }
    : null;

const articleSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonicalUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    datePublished: published,
    dateModified: modified,
    image: 'https://gauna.es/logo.svg',
    inLanguage: 'es-ES',
    keywords: post.data.tags.join(', '),
    author: { '@id': 'https://gauna.es/#organization' },
    publisher: { '@id': 'https://gauna.es/#organization' },
    isPartOf: { '@id': 'https://gauna.es/#website' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gauna.es/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://gauna.es/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  schema={articleSchema}
>
  <article class="py-16 md:py-20">
    <div class="container-g">
      <div class="max-w-prose mx-auto">
        <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-teal-600 mb-8">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver al blog
        </a>

        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 mb-6">
            <time datetime={published}>
              {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span>·</span>
            <span>{post.data.author}</span>
            {post.data.updatedDate && (
              <>
                <span>·</span>
                <span>Actualizado {post.data.updatedDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              </>
            )}
          </div>

          <h1 class="text-display-sm md:text-display-md font-medium text-slate-900 leading-tight">
            {post.data.title}
          </h1>
          <p class="text-xl text-slate-600 mt-6 leading-relaxed">
            {post.data.description}
          </p>
        </header>

        <div class="prose-g prose-lg">
          <Content />
        </div>

        <div class="mt-16 pt-10 border-t border-slate-200">
          {nextStep ? (
            <aside aria-labelledby="article-next-step-title" class="rounded-2xl border border-teal-100 bg-teal-50 p-6 md:p-8">
              <p class="text-xs font-medium uppercase tracking-widest text-teal-700">Llévalo a tu operativa</p>
              <h2 id="article-next-step-title" class="mt-3 text-2xl font-medium leading-tight text-slate-900">{nextStep.title}</h2>
              <p class="mt-4 leading-relaxed text-slate-700">{nextStep.description}</p>
              <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <a href={nextStep.productHref} class="btn-primary text-center">{nextStep.productLabel}</a>
                <a href="/solicitar-demo/" class="btn-secondary text-center">Solicitar una demo</a>
              </div>
              <p class="mt-5 text-sm">
                <a href={nextStep.resourceHref} class="font-medium text-teal-700 underline hover:text-teal-800">{nextStep.resourceLabel}</a>
              </p>
            </aside>
          ) : (
            <LeadMagnetForm
              variant="card"
              headline="¿Te ha sido útil este artículo?"
              subheadline="Suscríbete para recibir los siguientes directamente en tu email."
              id={`blog-${post.slug}-form`}
            />
          )}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
