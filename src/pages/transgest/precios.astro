---
import BaseLayout from '@layouts/BaseLayout.astro';
import PlanComparison from '@components/PlanComparison.astro';
import { planAnchor } from '../../config/public-site.mjs';

export const prerender = true;

const pageTitle = 'Planes de TransGest | TMS para empresas de transporte';
const pageDescription =
  'Compara TransGest Go, Control, Pro, Pro Intelligence y Planner según el nivel de gestión y el tipo de operativa que necesita tu empresa.';

const plans = [
  {
    name: 'Go',
    description: 'Para autónomos y pequeñas empresas que quieren empezar a digitalizar su operativa.',
    outcome: 'Orden y sencillez para dejar atrás la gestión dispersa.',
    features: ['Servicios y tráfico esencial', 'Clientes, vehículos y conductores', 'Documentación operativa', 'Acceso para conductores'],
    highlight: false,
  },
  {
    name: 'Control',
    description: 'Para empresas que necesitan un TMS profesional, claro y con una operativa conectada.',
    outcome: 'Control diario conectado entre tráfico y administración.',
    features: ['Operativa de tráfico ampliada', 'Avisos y gestión documental', 'Portal de clientes', 'Flujos administrativos conectados'],
    highlight: false,
  },
  {
    name: 'Pro',
    description: 'Para empresas que quieren controlar con profundidad todo lo que sucede en el negocio.',
    outcome: 'Visión completa de actividad, costes y rentabilidad.',
    features: ['Gestión integral de la empresa', 'Facturación avanzada', 'KPIs y rentabilidad', 'Mayor profundidad de control'],
    highlight: false,
  },
  {
    name: 'Pro Intelligence',
    description: 'Para empresas que quieren ganar velocidad y eficiencia mediante inteligencia artificial.',
    outcome: 'Menos tareas repetitivas sobre la base completa de TransGest.',
    features: ['Todo el alcance de Pro', 'Automatización de procesos', 'Funciones asistidas por IA', 'Procesamiento inteligente de información'],
    highlight: true,
  },
  {
    name: 'Planner',
    description: 'Para almacenes logísticos y centros que necesitan coordinar cargas, entradas, salidas, recursos y capacidad.',
    outcome: 'Planificación y trazabilidad de la operativa de almacén en un único entorno.',
    features: ['Gestión de cargas y expediciones', 'Entradas, salidas y planificación de muelles', 'Recursos, ubicaciones y estados', 'Coordinación y trazabilidad de almacén'],
    highlight: false,
  },
];

const faqs = [
  {
    question: '¿Los planes limitan el número de usuarios o vehículos?',
    answer: 'No. La elección del plan depende del nivel de gestión que necesita la empresa, no de cuántas personas o vehículos tenga.',
  },
  {
    question: '¿Cómo sé qué versión encaja con mi empresa?',
    answer: 'Revisamos contigo la operativa, el nivel de control que necesitas y los procesos que quieres centralizar. A partir de ahí te recomendamos la versión adecuada.',
  },
  {
    question: '¿Puede haber consumos adicionales?',
    answer: 'Algunas funciones con coste variable, como documentos generados o procesados, OCR, inteligencia artificial o integraciones específicas, pueden incluir límites o consumos asociados según la solución contratada.',
  },
  {
    question: '¿Qué es TransGest Planner?',
    answer: 'TransGest Planner es la versión orientada a almacenes y operaciones logísticas. Está pensada para gestionar cargas, entradas, salidas, recursos, muelles, capacidad y trazabilidad de la actividad del almacén.',
  },
  {
    question: '¿Qué diferencia Control, Pro y Pro Intelligence?',
    answer: 'Control pone el foco en conectar la operativa diaria de tráfico y administración. Pro añade profundidad de gestión, facturación avanzada y análisis de rentabilidad. Pro Intelligence parte del alcance de Pro e incorpora automatización y funciones asistidas por IA. En la demo revisamos el alcance disponible para tus procesos.',
  },
  {
    question: '¿Qué conviene concretar antes de contratar?',
    answer: 'La versión, la configuración, la implantación, la formación, el soporte y las integraciones necesarias. También conviene dejar claros los consumos variables y los desarrollos que se valorarían aparte. La propuesta debe responder a tu operativa concreta.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://gauna.es/transgest/precios/#webpage',
    name: pageTitle,
    description: pageDescription,
    url: 'https://gauna.es/transgest/precios/',
    inLanguage: 'es-ES',
    isPartOf: { '@id': 'https://gauna.es/#website' },
    about: { '@id': 'https://gauna.es/transgest/#software' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://gauna.es/transgest/precios/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gauna.es/' },
      { '@type': 'ListItem', position: 2, name: 'TransGest', item: 'https://gauna.es/transgest/' },
      { '@type': 'ListItem', position: 3, name: 'Planes', item: 'https://gauna.es/transgest/precios/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://gauna.es/transgest/precios/#faq',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/transgest/precios/"
  ogImageAlt="Planes de TransGest"
  schema={schema}
>
  <section class="py-20 md:py-28 bg-white">
    <div class="container-g">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow">Versiones TransGest</span>
        <h1 class="mt-4 text-display-md md:text-display-lg font-medium text-slate-900 leading-tight">Una versión para cada nivel de operativa.</h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-slate-600">TransGest evoluciona por profundidad de gestión y tipo de operación. No por número de usuarios ni por tamaño de flota.</p>
        <a href="#comparativa" class="mt-6 inline-flex text-sm font-semibold text-teal-700 underline underline-offset-4">Comparar las versiones de un vistazo</a>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {plans.map((plan) => (
          <article id={planAnchor(plan.name)} class:list={['scroll-mt-24 relative flex flex-col rounded-2xl border p-6', plan.highlight ? 'border-teal-700 bg-teal-900 text-white shadow-lg' : 'border-slate-200 bg-white']}>
            {plan.highlight ? <span class="self-start rounded-full bg-amber-400 px-2.5 py-1 text-xs font-semibold text-slate-900">Recomendado</span> : <span class="h-6"></span>}
            <h2 class="mt-5 text-2xl font-semibold">TransGest {plan.name}</h2>
            <p class:list={['mt-5 text-sm leading-relaxed', plan.highlight ? 'text-teal-50' : 'text-slate-600']}>{plan.description}</p>
            <p class:list={['mt-5 border-t pt-5 text-sm font-medium leading-relaxed', plan.highlight ? 'border-white/10 text-white' : 'border-slate-100 text-slate-900']}>{plan.outcome}</p>
            <ul class="mt-6 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <svg class:list={['mt-0.5 h-4 w-4 shrink-0', plan.highlight ? 'text-amber-300' : 'text-teal-700']} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  <span class:list={[plan.highlight ? 'text-teal-50' : 'text-slate-700']}>{feature}</span>
                </li>
              ))}
            </ul>
            <a href="/solicitar-demo/" data-plan={plan.name} class:list={['mt-8 inline-flex w-full items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition-colors', plan.highlight ? 'bg-amber-400 text-slate-950 hover:bg-amber-300' : 'bg-slate-900 text-white hover:bg-slate-800']}>Consultar esta versión</a>
          </article>
        ))}
      </div>

      <div class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-5 text-sm leading-relaxed text-slate-600">
        Durante la demo revisamos tu operativa y te recomendamos la versión y configuración adecuadas. Las funciones de consumo variable, integraciones y desarrollos específicos se dimensionan según cada proyecto.
      </div>
    </div>
  </section>

  <PlanComparison plans={plans} />

  <section id="faq" class="py-16 md:py-24 bg-slate-50">
    <div class="container-g grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-4">
        <span class="eyebrow">Cómo elegir</span>
        <h2 class="mt-3 text-display-sm font-medium text-slate-900 leading-tight">El alcance adecuado para tu operativa.</h2>
      </div>
      <div class="lg:col-span-8 space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-slate-200 bg-white">
            <summary class="flex cursor-pointer items-start justify-between gap-4 p-5 font-medium text-slate-900">
              <span>{faq.question}</span>
              <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 pb-5 leading-relaxed text-slate-600">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-teal-900 text-white">
    <div class="container-g max-w-3xl text-center">
      <h2 class="text-display-sm md:text-display-md font-medium leading-tight">¿Qué versión encaja con tu operativa?</h2>
      <p class="mt-5 text-lg text-teal-50">Te mostramos TransGest con casos cercanos a tu empresa y definimos contigo el alcance adecuado.</p>
      <a href="/solicitar-demo/" class="mt-8 inline-flex items-center justify-center rounded-lg bg-amber-500 px-7 py-3.5 font-medium text-slate-950 hover:bg-amber-400 transition-colors">Solicitar una demo</a>
    </div>
  </section>
</BaseLayout>
